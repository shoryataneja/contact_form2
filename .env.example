# SMTP credentials for sending contact form messages.
# Gmail: host smtp.gmail.com, port 465, use an App Password
# (Google Account → Security → 2-Step Verification → App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password

# Where contact form messages are delivered, and the From address.
# Both default to SMTP_USER when unset.
CONTACT_TO_EMAIL=you@gmail.com
CONTACT_FROM_EMAIL=you@gmail.com
